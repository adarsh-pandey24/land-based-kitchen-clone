// Admin CMS schema. Apply with `npx prisma migrate deploy` (see README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CateringService {
  id           String   @id @default(cuid())
  /// Service page key: chakna-and-tonic, grazing-tables-boards, party-catering, private-dining-events
  group        String   @default("")
  title        String
  slug         String   @unique
  /// One-line summary used on cards
  cardLine     String?
  /// Block headline on the service page
  heading      String?
  description  String
  imageUrl     String
  priceLabel   String?
  guests       String?
  format       String?
  goodFor      String?
  sampleDishes String?
  smallPrint   String?
  buttonLabel  String?
  published    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([group])
}

model ChefMenu {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  category    String
  /// Service page key, or "" to show on every service page
  group       String   @default("")
  imageUrl    String?
  pdfUrl      String?
  /// Ordered list of dishes: [{ name, description?, dietary? }]
  dishes      Json     @default("[]")
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([category])
  @@index([group])
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  altText   String
  caption   String?
  /// Service page key, "behind-the-scenes", or null for general.
  category  String?
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([category])
}

model Testimonial {
  id            String   @id @default(cuid())
  clientName    String
  content       String
  roleOrCompany String?
  published     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, sortOrder])
}

model ChefProfile {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  designation String
  biography   String
  imageUrl    String
  experience  String?
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

enum EnquiryStatus {
  NEW
  CONTACTED
  BOOKED
  CLOSED
}

/// Submissions from the website enquiry form.
model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  /// Event date as entered (YYYY-MM-DD); customers may give a best guess.
  eventDate String
  eventType String
  service   String
  guests    String
  venue     String
  format    String?
  dietary   String[]
  budget    String
  message   String?
  status    EnquiryStatus @default(NEW)
  /// Internal notes, never shown to the customer.
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}
