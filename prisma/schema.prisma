// Admin CMS schema. Apply with `npx prisma migrate deploy` (see README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CateringService {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  imageUrl    String
  priceLabel  String?
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model ChefMenu {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  category    String
  imageUrl    String?
  /// Ordered list of dishes: [{ name, description?, dietary? }]
  dishes      Json     @default("[]")
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([category])
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  altText   String
  caption   String?
  /// Optional page key, e.g. "private-chef", "private-dining", "bespoke-catering", "home".
  category  String?
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([category])
}

model Testimonial {
  id            String   @id @default(cuid())
  clientName    String
  content       String
  roleOrCompany String?
  published     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, sortOrder])
}

model ChefProfile {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  designation String
  biography   String
  imageUrl    String
  experience  String?
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}
