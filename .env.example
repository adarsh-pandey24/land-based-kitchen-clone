# Copy to .env and fill in. Never commit .env.

# NeonDB connection string (Neon dashboard > Connect). Keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Public site URL (no trailing slash), used for the sitemap and social images.
SITE_URL="https://www.example.com.au"

# Google reviews carousel (Places API (New)). Leave empty to hide the carousel.
# Key: Google Cloud console > APIs & Services > enable "Places API (New)" > Credentials.
# Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# Random secret, at least 32 characters, used to sign admin session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Used only by `npm run create-admin`. Remove ADMIN_PASSWORD after running it.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
