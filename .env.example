# Copy to .env and fill in. Never commit .env.

# NeonDB connection string (Neon dashboard > Connect). Keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Public site URL (no trailing slash), used for the sitemap and social images.
SITE_URL="https://www.example.com.au"

# Email each new enquiry to Joseph via Resend (resend.com). Leave empty to only
# save enquiries in the admin. ENQUIRY_EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=""
ENQUIRY_EMAIL_TO="thecoastncardamomau@gmail.com"
ENQUIRY_EMAIL_FROM=""

# Random secret, at least 32 characters, used to sign admin session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Used only by `npm run create-admin`. Remove ADMIN_PASSWORD after running it.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
